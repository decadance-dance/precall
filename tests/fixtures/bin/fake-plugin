#!/bin/sh
# A fake plugin for tests. Its scenario comes from the env var RRECALL_PARAM_SCENARIO (the
# instance's `scenario` param): ok (print RRECALL_PARAM_OUT), crash (exit 3), sleep (never
# answers; the pid of the sleep it starts goes to RRECALL_PARAM_RECORD.pid). It records its argv, cwd and RRECALL_* environment to RRECALL_PARAM_RECORD and its
# stdin to RRECALL_PARAM_RECORD.stdin, and writes one line to stderr.
rec="${RRECALL_PARAM_RECORD:-/dev/null}"
{
    printf 'argv:'
    for a in "$0" "$@"; do printf ' [%s]' "$a"; done
    printf '\ncwd: %s\n' "$(pwd -P)"
    env | grep '^RRECALL_' | sort
} > "$rec"
cat > "$rec.stdin"
echo "fake plugin: scenario ${RRECALL_PARAM_SCENARIO}" >&2
case "$RRECALL_PARAM_SCENARIO" in
    ok) printf '%s' "$RRECALL_PARAM_OUT" ;;
    crash) exit 3 ;;
    sleep) sleep 30 & echo $! > "$rec.pid"; wait ;;
    *) echo "fake plugin: unknown scenario" >&2; exit 64 ;;
esac
