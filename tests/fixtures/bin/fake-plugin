#!/bin/sh
# A fake plugin for tests. Its scenario comes from the env var PRECALL_PARAM_SCENARIO (the
# instance's `scenario` param): ok (print PRECALL_PARAM_OUT), seq (on the Nth call print line N
# of PRECALL_PARAM_OUT, the last line once the lines run out), binary (print a byte that is not
# UTF-8), all (a check or judge: the verdict PRECALL_PARAM_OUT for every `<collector>/<key>` in
# its input), crash (exit 3), leak (print PRECALL_PARAM_OUT on stdout and stderr), leak-crash
# (print PRECALL_PARAM_OUT on stderr and exit 3), sleep (never answers; the pid of the sleep it starts goes to
# PRECALL_PARAM_RECORD.pid). It records its argv, cwd and PRECALL_* environment to
# PRECALL_PARAM_RECORD, its stdin to PRECALL_PARAM_RECORD.stdin (and PRECALL_PARAM_RECORD.stdin.N
# for the Nth call), appends one line per call to PRECALL_PARAM_RECORD.calls, and writes one line
# to stderr.
rec="${PRECALL_PARAM_RECORD:-/dev/null}"
{
    printf 'argv:'
    for a in "$0" "$@"; do printf ' [%s]' "$a"; done
    printf '\ncwd: %s\n' "$(pwd -P)"
    env | grep '^PRECALL_' | sort
} > "$rec"
cat > "$rec.stdin"
n=1
if [ "$rec" != /dev/null ]; then
    echo call >> "$rec.calls"
    n=$(wc -l < "$rec.calls" | tr -d ' ')
    cp "$rec.stdin" "$rec.stdin.$n"
fi
echo "fake plugin: scenario ${PRECALL_PARAM_SCENARIO}" >&2
case "$PRECALL_PARAM_SCENARIO" in
    ok) printf '%s' "$PRECALL_PARAM_OUT" ;;
    seq)
        total=$(printf '%s\n' "$PRECALL_PARAM_OUT" | wc -l | tr -d ' ')
        [ "$n" -gt "$total" ] && n=$total
        printf '%s\n' "$PRECALL_PARAM_OUT" | sed -n "${n}p" | tr -d '\n' ;;
    all)
        printf '{"verdicts":['
        sep=
        for k in $(grep -o '"key":"[^"]*/[^"]*"' "$rec.stdin" | sed 's/"key"://'); do
            extra=
            [ "$PRECALL_PARAM_OUT" = revise ] && extra=',"instruction":"fake instruction"'
            printf '%s{"key":%s,"verdict":"%s","reason":"fake %s"%s}' "$sep" "$k" "$PRECALL_PARAM_OUT" "$PRECALL_PARAM_OUT" "$extra"
            sep=,
        done
        printf ']}' ;;
    binary) printf '\377' ;;
    crash) exit 3 ;;
    leak) printf '%s\n' "$PRECALL_PARAM_OUT" >&2; printf '%s' "$PRECALL_PARAM_OUT" ;;
    leak-crash) printf '%s\n' "$PRECALL_PARAM_OUT" >&2; exit 3 ;;
    sleep) sleep 30 & echo $! > "$rec.pid"; wait ;;
    *) echo "fake plugin: unknown scenario" >&2; exit 64 ;;
esac
